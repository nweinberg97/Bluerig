# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The app's own address, used in links we send (preview links, magic links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bluerig staff who can use /admin (comma-separated emails)
ADMIN_EMAILS=you@example.com

# Language model: any OpenAI-compatible endpoint serving an open-weight model
# (a hosted provider with no data retention, or your own vLLM server).
# Leave blank to use the built-in rule-based parser only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Text messages (claim codes, new-lead alerts). Leave blank to log to the server console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (new-lead alerts). Leave blank to log instead.
RESEND_API_KEY=
EMAIL_FROM=Bluerig <hello@example.com>

# Google Places API (New): shows the shop's Google rating and reviews with attribution.
GOOGLE_PLACES_API_KEY=

# Secret used to hash claim codes (any long random string)
CLAIM_SECRET=

# Twilio inbound webhook URL as configured in Twilio (for signature checks on STOP replies)
TWILIO_WEBHOOK_URL=
